{
  "name": "jsonforms-spartan",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build jsonforms-spartan && node -e \"require('node:fs').copyFileSync('LICENSE', 'dist/jsonforms-spartan/LICENSE')\"",
    "build:demo": "ng build demo",
    "watch": "ng build jsonforms-spartan --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dist": "node tools/check-dist.mjs",
    "helm:diff": "node tools/helm-diff.mjs",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "class-variance-authority": "^0.7.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@jsonforms/core": "~3.8.0",
    "@playwright/test": "^1.64.0",
    "@spartan-ng/brain": "^1.6.3",
    "@spartan-ng/cli": "^1.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.5.0",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "luxon": "^3.7.2",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
